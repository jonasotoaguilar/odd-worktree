{
  "name": "odd-worktree",
  "version": "0.1.0",
  "description": "Pi package for odd-worktree: the Agent Worktree tools (create, list, close, warp), the /warp worktree panel, the /odd-list ODD viewer, and the /issues GitHub issue reader. Works in Pi alone; Herdr is optional.",
  "keywords": [
    "pi-package",
    "pi",
    "worktree",
    "odd"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonasotoaguilar/odd-worktree.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions",
    "lib",
    "tools",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/odd-worktree-tools.ts"
    ]
  },
  "scripts": {
    "test": "node --test tools/*.test.js"
  }
}
